# ===========================================
# Настройки базы данных
# ===========================================
DB_LOGIN="vampqwe"
DB_PASSWORD="secret"
DB_HOST="127.0.0.1"
DB_PORT="3307"
DB_NAME="vampqwe"
DB_CHARSET="utf8mb4"
DB_DRIVER="mysql"

# ===========================================
# DateTime config
# ===========================================
DEFAULT_TIMEZONE=Europe/Minsk
DATE_TPL=Y-m-d
TIME_TPL=H:i:s

# ===========================================
# Режим работы
# ===========================================
ACTIVE_MODE=MODE_DB

# ===========================================
# Режим отладки: true — показывать стек-трейсы в HTML (только локальная разработка),
# false/пусто — продакшен (ошибки только в лог).
# Можно переопределить без правки этого файла: создать .env в корне проекта со строкой APP_DEBUG=true
# ===========================================
APP_DEBUG=true

# ===========================================
# Настройки сессий
# ===========================================
SAVE_SESSION_HANDLER=redis
SAVE_SESSION_PATH_METHOD=tcp
SAVE_SESSION_PATH_HOST=127.0.0.1
SAVE_SESSION_PATH_PORT=6379
SAVE_SESSION_PATH_AUTH=
SESSION.GC_MAXLIFETIME=3600
SESSION.COOKIE_LIFETIME=3600
SESSION.COOKIE_HTTPONLY=1
SESSION.COOKIE_SECURE=1
SESSION.COOKIE_SAMESITE=strict

# ===========================================
# Настройки сайта
# ===========================================
SITE_URL="https://usyplenie.103vet.by/"
SITE_NAME="Достойный уход"
DEFAULT_TIMEZONE="Europe/Minsk"
