# Файл конфигурации проекта .env
# Перенесённые настройки из config.ini

# ===========================================
# Настройки базы данных
# ===========================================
DB_LOGIN=root
DB_PASSWORD=root
DB_HOST=localhost
DB_NAME=inventory
DB_CHARSET=utf8
DB_DRIVER=mysql

# ===========================================
# DateTime config
# ===========================================
# Форматы даты и времени:
# -- F j, Y, g:i a                 // March 10, 2001, 5:16 pm
# -- m.d.y                         // 03.10.01
# -- j, n, Y                       // 10, 3, 2001
# -- Ymd                           // 20010310
# -- h-i-s, j-m-y, it is w Day     // 05-16-18, 10-03-01, 1631 1618 6 Satpm01
# -- D M j G:i:s T Y               // Sat Mar 10 17:16:18 MST 2001
# -- H:i:s                         // 17:16:18
# -- Y-m-d H:i:s                   // 2001-03-10 17:16:18 формат MySQL DATETIME
DEFAULT_TIMEZONE=Europe/Minsk
DATE_TPL=Y-m-d
TIME_TPL=H:i:s

# ===========================================
# Режим работы
# ===========================================
ACTIVE_MODE=MODE_DB

# ===========================================
# Настройки сессий
# ===========================================
# Доступные значения: 'files', 'redis'
SAVE_SESSION_HANDLER=files
# Метод подключения для Redis (tcp, unix)
SAVE_SESSION_PATH_METHOD=tcp
# Хост для Redis
SAVE_SESSION_PATH_HOST=127.0.0.1
# Порт для Redis
SAVE_SESSION_PATH_PORT=6379
# Пароль для Redis (оставьте пустым, если пароль не требуется)
SAVE_SESSION_PATH_AUTH=
